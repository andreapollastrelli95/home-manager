# Segreti della funzione "assistente": restano sul server, mai nell'app né nel repository.
# Copia in supabase/functions/.env, metti i tuoi valori, poi:
#   supabase secrets set --env-file supabase/functions/.env
GEMINI_API_KEY=inserisci-qui-la-tua-chiave
GEMINI_MODEL=inserisci-qui-il-nome-del-modello
