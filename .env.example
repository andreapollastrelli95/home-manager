# Copia questo file in ".env.local" e inserisci i tuoi valori. NON committare ".env.local".
# Servono solo valori PUBBLICI: l'indirizzo del progetto e la chiave "anon" / "publishable".
# Non inserire MAI la chiave "service_role" / "secret": l'app la rifiuta.

# Supabase > Project Settings > API > Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# Supabase > Project Settings > API > anon (publishable) key
VITE_SUPABASE_ANON_KEY=

# La chiave Gemini NON va qui (questo file riguarda l'app nel browser):
# si configura sul server, vedi supabase/functions/.env.example

# Facoltativo: "true" solo dopo aver configurato un servizio email (SMTP) su Supabase: mostra «Password dimenticata?»
VITE_PASSWORD_RESET_ENABLED=false

# Facoltativo: indirizzo della demo, mostrato come link nella schermata di accesso
VITE_DEMO_URL=
