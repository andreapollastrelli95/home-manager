{
    "name": "home-manager",
    "version": "0.1.0",
    "description": "Home e Car Manager - gestionale di casa e auto",
    "keywords": [],
    "author": "Andrea Pollastrelli",
    "license": "ISC",
    "dependencies": {
        "@supabase/supabase-js": "^2.119.2",
        "dexie": "^4.4.7",
        "dexie-react-hooks": "^4.4.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "autoprefixer": "^10.6.2",
        "electron": "^45.2.3",
        "electron-builder": "^26.18.0",
        "postcss": "^8.5.32",
        "qrcode": "^1.5.4",
        "tailwindcss": "^3.4.19",
        "typescript": "^7.0.2",
        "vite": "^8.3.6"
    },
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "vite",
        "dev:demo": "vite --mode demo",
        "build": "tsc --noEmit && vite build",
        "build:demo": "tsc --noEmit && vite build --mode demo",
        "build:local": "tsc --noEmit && vite build --mode personale",
        "volantino": "node docs/home-car/volantino/build.mjs",
        "guida": "node docs/home-car/guida/build.mjs",
        "pack": "npm run build:local && electron-builder --win --dir"
    },
    "build": {
        "appId": "local.homemanager",
        "productName": "Home Manager",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**",
            "electron/**",
            "server/**",
            "package.json"
        ],
        "win": {
            "target": "dir",
            "signAndEditExecutable": false
        }
    },
    "type": "module"
}
